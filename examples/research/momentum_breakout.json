{
  "dsl_version": 1,
  "name": "Momentum Breakout",
  "description": "Research candidate — not a trading recommendation. Buys an outcome between 0.30 and 0.80 that rose ≥ 15% in an hour on at least 2× its usual volume, exiting at +20%, −15% or after 12 hours: tests short-term momentum.",
  "universe": {
    "side": "BUY_YES",
    "min_volume_asof": 10000,
    "min_time_to_resolution_minutes": 60
  },
  "entry": {
    "all": [
      {
        "feature": "price",
        "params": {},
        "op": "gte",
        "value": 0.3
      },
      {
        "feature": "price",
        "params": {},
        "op": "lte",
        "value": 0.8
      },
      {
        "feature": "price_change_pct",
        "params": {
          "lookback_minutes": 60
        },
        "op": "gte",
        "value": 0.15
      },
      {
        "feature": "volume_ratio",
        "params": {
          "lookback_minutes": 60,
          "baseline_minutes": 720
        },
        "op": "gte",
        "value": 2
      },
      {
        "feature": "staleness_minutes",
        "params": {},
        "op": "lte",
        "value": 10
      }
    ]
  },
  "sizing": {
    "mode": "PCT_OF_EQUITY",
    "value": 0.05,
    "max_notional_per_trade": 50.0,
    "min_order_policy": "ROUND_UP",
    "round_up_max_multiple": 2.0
  },
  "exit": {
    "any": [
      {
        "type": "TAKE_PROFIT_PCT",
        "value": 0.2
      },
      {
        "type": "STOP_LOSS_PCT",
        "value": 0.15
      },
      {
        "type": "MAX_HOLD_MINUTES",
        "value": 720
      }
    ]
  },
  "constraints": {
    "max_open_positions": 10,
    "max_total_exposure_pct": 0.6,
    "max_positions_per_event": 1,
    "cooldown_minutes_per_market": 240,
    "allow_reentry_same_market": true
  }
}