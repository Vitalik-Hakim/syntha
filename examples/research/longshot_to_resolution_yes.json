{
  "dsl_version": 1,
  "name": "Longshot to Resolution (YES)",
  "description": "Research candidate — not a trading recommendation. Buys YES priced 0.03–0.10 within 24 hours of the scheduled end and holds to settlement, many small positions: tests whether longshots are underpriced (July calibration showed longshots paying out more often than priced; unconfirmed).",
  "universe": {
    "side": "BUY_YES",
    "min_volume_asof": 10000
  },
  "entry": {
    "all": [
      {
        "feature": "price",
        "params": {},
        "op": "gte",
        "value": 0.03
      },
      {
        "feature": "price",
        "params": {},
        "op": "lte",
        "value": 0.1
      },
      {
        "feature": "time_to_resolution_minutes",
        "params": {},
        "op": "lte",
        "value": 1440
      },
      {
        "feature": "staleness_minutes",
        "params": {},
        "op": "lte",
        "value": 10
      }
    ]
  },
  "sizing": {
    "mode": "PCT_OF_INITIAL",
    "value": 0.01,
    "max_notional_per_trade": 25.0,
    "min_order_policy": "ROUND_UP",
    "round_up_max_multiple": 2.0
  },
  "exit": {
    "any": []
  },
  "constraints": {
    "max_open_positions": 40,
    "max_total_exposure_pct": 0.6,
    "max_positions_per_event": 1,
    "cooldown_minutes_per_market": 0,
    "allow_reentry_same_market": false
  }
}