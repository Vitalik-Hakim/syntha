{
  "$defs": {
    "BasketEntry": {
      "additionalProperties": false,
      "description": "v3 E3: buy every open sibling of an event as one all-or-nothing basket when the set\nidentity leaves an edge. YES set: Σ P(yes) ≤ 1 − c; NO set: Σ P(no) ≤ (N − 1) − c, with\nc = Σ leg fees + one tick per leg + `min_edge`.",
      "properties": {
        "kind": {
          "enum": [
            "NEGRISK_YES_SET",
            "NEGRISK_NO_SET"
          ],
          "title": "Kind",
          "type": "string"
        },
        "min_edge": {
          "default": 0.0,
          "description": "Extra margin per unit beyond fees and ticks",
          "minimum": 0,
          "title": "Min Edge",
          "type": "number"
        },
        "min_markets": {
          "default": 3,
          "minimum": 2,
          "title": "Min Markets",
          "type": "integer"
        },
        "require_catch_all": {
          "default": true,
          "description": "Only sets with a listed catch-all market are exhaustive (v3 §4.2)",
          "title": "Require Catch All",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BasketEntry",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "enum": [
            "price",
            "price_change_pct",
            "price_change_abs",
            "traded_volume",
            "volume_ratio",
            "print_count",
            "vwap_gap",
            "realized_vol",
            "time_to_resolution_minutes",
            "time_since_open_minutes",
            "spread_proxy",
            "staleness_minutes",
            "minutes_since_last_print"
          ],
          "title": "Feature",
          "type": "string"
        },
        "op": {
          "enum": [
            "lt",
            "lte",
            "gt",
            "gte",
            "eq",
            "neq"
          ],
          "title": "Op",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Params",
          "type": "object"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "op",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "allow_reentry_same_market": {
          "default": true,
          "title": "Allow Reentry Same Market",
          "type": "boolean"
        },
        "cooldown_minutes_per_market": {
          "default": 0,
          "minimum": 0,
          "title": "Cooldown Minutes Per Market",
          "type": "integer"
        },
        "max_open_positions": {
          "default": 5,
          "minimum": 1,
          "title": "Max Open Positions",
          "type": "integer"
        },
        "max_positions_per_event": {
          "default": 1,
          "minimum": 1,
          "title": "Max Positions Per Event",
          "type": "integer"
        },
        "max_total_exposure_pct": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Total Exposure Pct",
          "type": "number"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "DatasetSelection": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Collection name; None = all markets.",
          "title": "Collection"
        },
        "condition_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Ids"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "title": "DatasetSelection",
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "All"
        },
        "any": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Any"
        },
        "basket": {
          "anyOf": [
            {
              "$ref": "#/$defs/BasketEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "print_trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrintTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "random": {
          "anyOf": [
            {
              "$ref": "#/$defs/RandomEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Entry",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "adverse_selection": {
          "default": false,
          "description": "TRADE_PRINT fills at the worst print in the bar instead of VWAP.",
          "title": "Adverse Selection",
          "type": "boolean"
        },
        "allow_fill_on_no_prints": {
          "default": false,
          "title": "Allow Fill On No Prints",
          "type": "boolean"
        },
        "liquidity_participation": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.1,
          "description": "Share of the bar's printed size we may take. None = unlimited.",
          "title": "Liquidity Participation"
        },
        "liquidity_side": {
          "$ref": "#/$defs/LiquiditySide",
          "default": "SAME_SIDE",
          "description": "v3 E2: which taker prints are liquidity. SAME_SIDE: a buy fills against prints other takers bought (ask liquidity), a sell against prints they sold. BOTH: every print in the bar (v2 behaviour, optimistic)."
        },
        "model": {
          "$ref": "#/$defs/ExecutionModel",
          "default": "TRADE_PRINT"
        },
        "partial_fill_policy": {
          "$ref": "#/$defs/PartialFillPolicy",
          "default": "ALLOW"
        },
        "slippage_bps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slippage Bps"
        },
        "slippage_ticks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "title": "Slippage Ticks"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "ExecutionModel": {
      "description": "§11 — BOOK is v2 and only valid where recorded L2 data covers the period.",
      "enum": [
        "LAST_PRICE",
        "TRADE_PRINT",
        "BOOK"
      ],
      "title": "ExecutionModel",
      "type": "string"
    },
    "Exit": {
      "additionalProperties": false,
      "description": "Evaluated in list order; the first rule that fires names the exit reason. An empty list\nmeans hold until settlement (or the end of the backtest).",
      "properties": {
        "any": {
          "items": {
            "discriminator": {
              "mapping": {
                "MAX_HOLD_MINUTES": "#/$defs/MaxHold",
                "PRICE_ABOVE": "#/$defs/PriceAbove",
                "PRICE_BELOW": "#/$defs/PriceBelow",
                "RULE": "#/$defs/RuleExit",
                "STOP_LOSS_PCT": "#/$defs/StopLoss",
                "TAKE_PROFIT_PCT": "#/$defs/TakeProfit",
                "WALLET_SELL": "#/$defs/WalletSellExit"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TakeProfit"
              },
              {
                "$ref": "#/$defs/StopLoss"
              },
              {
                "$ref": "#/$defs/PriceAbove"
              },
              {
                "$ref": "#/$defs/PriceBelow"
              },
              {
                "$ref": "#/$defs/MaxHold"
              },
              {
                "$ref": "#/$defs/RuleExit"
              },
              {
                "$ref": "#/$defs/WalletSellExit"
              }
            ]
          },
          "title": "Any",
          "type": "array"
        }
      },
      "title": "Exit",
      "type": "object"
    },
    "FeeConfig": {
      "additionalProperties": false,
      "properties": {
        "fixed_exponent": {
          "default": 1,
          "minimum": 1,
          "title": "Fixed Exponent",
          "type": "integer"
        },
        "fixed_rate": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Rate"
        },
        "mode": {
          "$ref": "#/$defs/FeeMode",
          "default": "HISTORICAL"
        }
      },
      "title": "FeeConfig",
      "type": "object"
    },
    "FeeMode": {
      "description": "§3.7.",
      "enum": [
        "HISTORICAL",
        "CURRENT",
        "FIXED"
      ],
      "title": "FeeMode",
      "type": "string"
    },
    "HonestyConfig": {
      "additionalProperties": false,
      "description": "The statistical honesty layer (PRD §15), run with every backtest. Iteration counts are part\nof the config hash: the tests are seeded from the request's seed, so they are reproducible.",
      "properties": {
        "bootstrap_iterations": {
          "default": 10000,
          "maximum": 100000,
          "minimum": 0,
          "title": "Bootstrap Iterations",
          "type": "integer"
        },
        "buy_and_hold": {
          "default": true,
          "title": "Buy And Hold",
          "type": "boolean"
        },
        "permutations": {
          "default": 200,
          "description": "Market-shuffle permutation test iterations",
          "maximum": 5000,
          "minimum": 0,
          "title": "Permutations",
          "type": "integer"
        },
        "random_baselines": {
          "default": 50,
          "description": "Random-entry baseline simulations",
          "maximum": 5000,
          "minimum": 0,
          "title": "Random Baselines",
          "type": "integer"
        }
      },
      "title": "HonestyConfig",
      "type": "object"
    },
    "LiquiditySide": {
      "description": "v3 E2 — which taker prints count as liquidity for a fill.",
      "enum": [
        "SAME_SIDE",
        "BOTH"
      ],
      "title": "LiquiditySide",
      "type": "string"
    },
    "MaxHold": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MAX_HOLD_MINUTES",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "MaxHold",
      "type": "object"
    },
    "Order": {
      "additionalProperties": false,
      "description": "v3 E1: how signals become orders. LIMIT is the default for all research: a buy limit is\nthe signal price plus `limit_offset_ticks`, a sell limit is the signal price minus it, and\nthe order rests for `ttl_bars` bars before it expires. MARKET keeps v2 behaviour and is\nflagged as having no price protection.",
      "properties": {
        "limit_offset_ticks": {
          "default": 1,
          "minimum": 0,
          "title": "Limit Offset Ticks",
          "type": "integer"
        },
        "ttl_bars": {
          "default": 5,
          "minimum": 1,
          "title": "Ttl Bars",
          "type": "integer"
        },
        "type": {
          "default": "LIMIT",
          "enum": [
            "LIMIT",
            "MARKET"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "title": "Order",
      "type": "object"
    },
    "PartialFillPolicy": {
      "description": "§11.3.",
      "enum": [
        "ALLOW",
        "REJECT"
      ],
      "title": "PartialFillPolicy",
      "type": "string"
    },
    "PriceAbove": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "PRICE_ABOVE",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "PriceAbove",
      "type": "object"
    },
    "PriceBelow": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "PRICE_BELOW",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "PriceBelow",
      "type": "object"
    },
    "PrintTrigger": {
      "additionalProperties": false,
      "description": "v3 E4 / S3: enter when a taker print of at least `min_notional` by one of `wallets` (any\nwallet when null) lands in the bar. The signal remembers the wallet, so a WALLET_SELL exit\ncan watch for its sale.",
      "properties": {
        "min_notional": {
          "default": 0,
          "minimum": 0,
          "title": "Min Notional",
          "type": "number"
        },
        "side": {
          "default": "BUY",
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        },
        "wallets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wallets"
        }
      },
      "title": "PrintTrigger",
      "type": "object"
    },
    "RandomEntry": {
      "additionalProperties": false,
      "description": "Null-hypothesis entries (PRD §8.3): each eligible bar enters with this probability.",
      "properties": {
        "probability_per_bar": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Probability Per Bar",
          "type": "number"
        }
      },
      "required": [
        "probability_per_bar"
      ],
      "title": "RandomEntry",
      "type": "object"
    },
    "RuleExit": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "type": {
          "const": "RULE",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "condition"
      ],
      "title": "RuleExit",
      "type": "object"
    },
    "Side": {
      "description": "§3.3 — there is no shorting; short YES is expressed as BUY_NO. EITHER makes both tokens of\neach market candidates, so the entry rules choose the side (a price ≥ 0.9 rule buys the\nfavourite, whichever outcome that is); a market never holds both sides at once.",
      "enum": [
        "BUY_YES",
        "BUY_NO",
        "EITHER"
      ],
      "title": "Side",
      "type": "string"
    },
    "Sizing": {
      "additionalProperties": false,
      "properties": {
        "max_notional_per_trade": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Notional Per Trade"
        },
        "min_order_policy": {
          "default": "SKIP",
          "description": "When the sized order is below the market's minimum order size: SKIP rejects it (REJECTED_MIN_SIZE); ROUND_UP places the minimum instead, if cash, exposure headroom, max_notional_per_trade and the liquidity cap all still allow it and it is at most round_up_max_multiple times the requested notional.",
          "enum": [
            "SKIP",
            "ROUND_UP"
          ],
          "title": "Min Order Policy",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/SizingMode"
        },
        "round_up_max_multiple": {
          "default": 2.0,
          "maximum": 20.0,
          "minimum": 1.0,
          "title": "Round Up Max Multiple",
          "type": "number"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "mode",
        "value"
      ],
      "title": "Sizing",
      "type": "object"
    },
    "SizingMode": {
      "description": "§10.3.",
      "enum": [
        "FIXED_CASH",
        "PCT_OF_EQUITY",
        "PCT_OF_INITIAL",
        "FIXED_SHARES"
      ],
      "title": "SizingMode",
      "type": "string"
    },
    "StopLoss": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "STOP_LOSS_PCT",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "StopLoss",
      "type": "object"
    },
    "StrategyDSL": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dsl_version": {
          "const": 1,
          "default": 1,
          "title": "Dsl Version",
          "type": "integer"
        },
        "entry": {
          "$ref": "#/$defs/Entry"
        },
        "exit": {
          "$ref": "#/$defs/Exit"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "order": {
          "$ref": "#/$defs/Order"
        },
        "sizing": {
          "$ref": "#/$defs/Sizing"
        },
        "universe": {
          "$ref": "#/$defs/Universe"
        }
      },
      "required": [
        "name",
        "entry",
        "sizing"
      ],
      "title": "StrategyDSL",
      "type": "object"
    },
    "TakeProfit": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "TAKE_PROFIT_PCT",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "TakeProfit",
      "type": "object"
    },
    "Universe": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Categories"
        },
        "min_time_to_resolution_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minutes until the *scheduled* end date.",
          "title": "Min Time To Resolution Minutes"
        },
        "min_volume_asof": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cumulative traded notional (USDC) up to the bar.",
          "title": "Min Volume Asof"
        },
        "side": {
          "$ref": "#/$defs/Side",
          "default": "BUY_YES"
        }
      },
      "title": "Universe",
      "type": "object"
    },
    "WalletSellExit": {
      "additionalProperties": false,
      "description": "v3 E4: exit when the wallet whose print triggered the entry sells the same token.",
      "properties": {
        "type": {
          "const": "WALLET_SELL",
          "title": "Type",
          "type": "string"
        },
        "wallet_ref": {
          "const": "signal",
          "default": "signal",
          "title": "Wallet Ref",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "WalletSellExit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bar_interval_minutes": {
      "default": 1,
      "enum": [
        1,
        5,
        15,
        60
      ],
      "title": "Bar Interval Minutes",
      "type": "integer"
    },
    "check_invariants": {
      "default": true,
      "title": "Check Invariants",
      "type": "boolean"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetSelection"
    },
    "decision_lag_bars": {
      "default": 1,
      "minimum": 0,
      "title": "Decision Lag Bars",
      "type": "integer"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionConfig"
    },
    "fees": {
      "$ref": "#/$defs/FeeConfig"
    },
    "honesty": {
      "$ref": "#/$defs/HonestyConfig"
    },
    "max_stale_minutes": {
      "default": 60,
      "description": "Entries need a price observed within this many minutes.",
      "minimum": 0,
      "title": "Max Stale Minutes",
      "type": "integer"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "settle_winnings_fee_free": {
      "default": true,
      "description": "No fee on redemption (docs/DATA_NOTES.md assumptions).",
      "title": "Settle Winnings Fee Free",
      "type": "boolean"
    },
    "share_precision": {
      "default": 2,
      "maximum": 6,
      "minimum": 0,
      "title": "Share Precision",
      "type": "integer"
    },
    "starting_capital": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
