{
  "name": "single_trade_tp",
  "asserts": "One entry, take-profit hit, exact fee and slippage arithmetic",
  "derivation": [
    "LAST_PRICE, 1 tick slippage, FIXED fee rate 0.04 exponent 1, FIXED_CASH 10, take profit 10%.",
    "Bar prices: m0-m2 0.40, m3-m5 0.46. Entry rule price <= 0.40 fires at m0; executes at m1 (lag 1).",
    "Entry: ref 0.40 + 0.01 = 0.41. shares = floor(10 / 0.41, 2dp) = floor(24.3902) = 24.39.",
    "Entry fee = 24.39 x 0.04 x (0.41 x 0.59) = 24.39 x 0.009676 = 0.23599764 -> 0.23600 (5 dp).",
    "Cash after entry = 100 - 24.39 x 0.41 (9.9999) - 0.23600 = 89.76410.",
    "m2: 0.40 < 0.41 x 1.10 = 0.451. m3: 0.46 >= 0.451 -> exit signal; executes m4.",
    "Exit: ref 0.46 - 0.01 = 0.45. Proceeds 24.39 x 0.45 = 10.9755. Fee = 24.39 x 0.04 x (0.45 x 0.55) = 0.241461 -> 0.24146.",
    "Cash = 89.76410 + 10.9755 - 0.24146 = 100.49814.",
    "gross = 24.39 x (0.46 - 0.40) = 1.4634; slippage = 24.39 x 0.01 x 2 = 0.4878; fees = 0.47746; net = 1.4634 - 0.4878 - 0.47746 = 0.49814."
  ],
